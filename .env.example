APP_NAME="FastAPI Modular Service"
API_PREFIX="/api/v1"

# ============ MySQL 配置 ============
# 外部 MySQL：填真实 IP/域名，例如 10.0.0.12 或 db.example.com
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_HOST="mysql"
MYSQL_PORT=3306
MYSQL_DB="fastapi_demo"

# ============ Celery / Redis 配置 ============
# 外部 Redis：将 redis 改为真实 IP/域名，例如 10.0.0.21
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"
